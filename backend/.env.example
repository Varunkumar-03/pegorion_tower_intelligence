# Pegorion Backend Environment Configuration
# Copy this file to .env and update values for your environment

# Database Configuration
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/pegorion

# Security
# Generate a secure key: python -c "from secrets import token_urlsafe; print(token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# Authentication
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Frontend origin for API requests
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Document Storage
DOCUMENT_STORAGE_PATH=/app/data/documents
MAX_FILE_SIZE_MB=50

# AI Provider Configuration
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Redis for Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Logging Level
LOG_LEVEL=INFO